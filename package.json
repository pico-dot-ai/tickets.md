{
  "name": "tickets-repo",
  "private": true,
  "workspaces": [
    "apps/site",
    "packages/tickets"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @picoai/tickets-site",
    "build": "npm run build --workspace @picoai/tickets-site",
    "start": "npm run start --workspace @picoai/tickets-site",
    "test": "npm run test --workspace @picoai/tickets",
    "test:cli": "npm run test:cli --workspace @picoai/tickets",
    "release:status": "npm run release:status --workspace @picoai/tickets",
    "release:tag": "node ./scripts/push-release-tag.mjs",
    "tickets": "npm run tickets --workspace @picoai/tickets --"
  }
}
